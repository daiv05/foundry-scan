# PocketBase admin credentials (used by docker-compose)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme

# ── Backend (see backend/.env.example for the full list) ──────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=7120
POCKETBASE_URL=http://pocketbase:7130
FRONTEND_ORIGIN=http://localhost:7110

# Collector settings
COLLECTOR_REQUEST_DELAY_MS=1200
REDDIT_FETCH_COMMENTS=true

# Google Trends
TRENDS_GEO=US
TRENDS_TIMEFRAME=now 7-d

# Product Hunt (optional - leave blank to skip)
PRODUCTHUNT_TOKEN=
