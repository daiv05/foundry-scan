# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=7120
POCKETBASE_URL=http://127.0.0.1:7130
FRONTEND_ORIGIN=http://localhost:7110
PB_ADMIN_EMAIL=admin@alcsaas.dev
PB_ADMIN_PASSWORD=changeme

# External APIs
# Reddit — scraping con Playwright, sin credenciales
REDDIT_REQUEST_DELAY_MS=2000      # delay mínimo entre páginas (ms)
REDDIT_FETCH_COMMENTS=false       # true = carga página del post para obtener comentarios (más lento)
# Trends (PyTrends no necesita credenciales; Playwright como fallback)
TRENDS_GEO=          # código de país, ej: US  (vacío = mundial)
TRENDS_TIMEFRAME=today 3-m
PRODUCTHUNT_TOKEN=

# Cloudflare (optional)
CLOUDFLARED_TOKEN=
