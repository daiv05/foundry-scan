# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=7120
FRONTEND_ORIGIN=http://localhost:7110

# ── PocketBase ────────────────────────────────────────────────────────────────
POCKETBASE_URL=http://localhost:7130
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme

# ── Collector settings ────────────────────────────────────────────────────────
COLLECTOR_REQUEST_DELAY_MS=1200
REDDIT_FETCH_COMMENTS=true

# ── Google Trends ─────────────────────────────────────────────────────────────
TRENDS_GEO=US
TRENDS_TIMEFRAME=now 7-d

# ── Product Hunt (optional - leave blank to skip) ────────────────────────────
# Get a token at https://api.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=
